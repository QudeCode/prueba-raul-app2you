
@startuml arquitectura

title Arquitectura por capas - Reserva de Recursos

' CONFIGURACION GENERAL

left to right direction

skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 50
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam defaultFontSize 12
skinparam ArrowFontSize 10
skinparam ArrowColor #546E7A
skinparam ArrowThickness 1

skinparam package {
    BorderColor #78909C
    FontStyle bold
}

skinparam component {
    BorderColor #90A4AE
    BackgroundColor #FFFFFF
}

' =====================================================
' FRONTEND - ANGULAR
' =====================================================

package "FRONTEND · Angular" as FE {

    package "Presentación" as FP #E3F2FD {

        [App (cabecera)] as App
        [SelectorUsuario] as SelectorUsuario

        [RecursosPage] as RecursosPage
        [RecursoDetallePage] as RecursoDetallePage
        [ReservasPage] as ReservasPage

        [RecursoCard /\nRecursoCabecera] as RecursoCard

        [Componentes de reservas\n(Calendario, NavegacionDia,\nTimeline, ReservasDelDia,\nReservaModal, ReservaCard,\nAccionDialogo)] as ComponentesReservas

        [common/dialogo] as Dialogo

        App --> RecursosPage : router
        App --> RecursoDetallePage : router
        App --> ReservasPage : router
        App --> SelectorUsuario : input

        RecursosPage --> RecursoCard : input
        RecursoDetallePage --> RecursoCard : input

        RecursoDetallePage --> ComponentesReservas : input
        ReservasPage --> ComponentesReservas : input

        ComponentesReservas --> Dialogo : input
    }

    package "Datos" as FD #BBDEFB {

        [RecursosService] as RecursosService
        [UsuariosService] as UsuariosService
        [ReservasService] as ReservasService

        ReservasService ..> UsuariosService : inject
    }

    package "Modelo del frontend" as FM #FFF8E1 {

        [recurso.model] as RecursoModel
        [usuario.model] as UsuarioModel
        [reserva.model\n(tipos y reglas)] as ReservaModel
        [common/enums\ncommon/fechas] as ComunFront
    }

    RecursosPage --> RecursosService : inject

    RecursoDetallePage --> RecursosService : inject
    RecursoDetallePage --> ReservasService : inject

    ReservasPage --> ReservasService : inject
    ReservasPage --> UsuariosService : inject

    App --> UsuariosService : inject

    FP ..> FM : utiliza
    FD ..> FM : utiliza

    FP -[hidden]down-> FD
    FD -[hidden]down-> FM
}

' =====================================================
' BACKEND - FASTAPI
' =====================================================

package "BACKEND · FastAPI" as BE {

    package "Controller" as BC #E8F5E9 {

        [usuarios/controller] as UsuariosController
        [recursos/controller] as RecursosController
        [reservas/controller] as ReservasController

        [usuario actual\n(X-Usuario-Id)] as UsuarioActual
        [manejador de errores\n(main)] as Manejador
    }

    package "Service" as BS #C8E6C9 {

        [UsuarioService] as UsuarioService
        [RecursoService] as RecursoService
        [ReservaService] as ReservaService
        [DisponibilidadService] as DisponibilidadService
    }

    package "Repository" as BR #A5D6A7 {

        [UsuarioRepository] as UsuarioRepository
        [RecursoRepository] as RecursoRepository
        [ReservaRepository] as ReservaRepository
    }

    package "Modelo del backend" as BM #FFF8E1 {

        [DTO\n(usuarios, recursos,\nreservas)] as DTO
        [Entity\n(Usuario, Recurso,\nReserva)] as Entity

        [common/enums\ncommon/horas] as ComunBack
        [errores del dominio] as Errores
    }

    UsuariosController --> UsuarioService : Depends
    RecursosController --> RecursoService : Depends
    ReservasController --> ReservaService : Depends
    ReservasController --> DisponibilidadService : Depends

    UsuarioActual --> UsuarioService : Depends

    UsuarioService --> UsuarioRepository : Depends
    RecursoService --> RecursoRepository : Depends
    ReservaService --> ReservaRepository : Depends
    DisponibilidadService --> ReservaRepository : Depends

    ReservaService ..> DisponibilidadService : consulta
    ReservaService ..> RecursoService : consulta
    ReservaService ..> UsuarioService : consulta
    DisponibilidadService ..> RecursoService : consulta

    BC ..> DTO : utiliza
    BS ..> DTO : utiliza
    BS ..> Entity : utiliza
    BS ..> Errores : lanza
    BR ..> Entity : utiliza

    Manejador ..> Errores : traduce a HTTP

    BC -[hidden]down-> BS
    BS -[hidden]down-> BR
    BR -[hidden]down-> BM
}

' =====================================================
' COMUNICACION ENTRE FRONTEND Y BACKEND
' =====================================================

RecursosService --> RecursosController : HTTP GET /recursos\nGET /recursos/{id}

UsuariosService --> UsuariosController : HTTP GET /usuarios

ReservasService --> ReservasController : HTTP /reservas\n/recursos/{id}/disponibilidad\n(X-Usuario-Id)

' =====================================================
' BASE DE DATOS
' =====================================================

database "PostgreSQL · Docker Compose" as BD {

    [usuario] as TUsuario
    [recurso] as TRecurso
    [reserva] as TReserva
}

UsuarioRepository --> BD : SQL
RecursoRepository --> BD : SQL
ReservaRepository --> BD : SQL

Entity ..> BD : mapea

' =====================================================
' POSICIONAMIENTO GENERAL
' =====================================================

FE -[hidden]right-> BE
BE -[hidden]right-> BD

@enduml
