@startuml arquitectura
title Arquitectura por capas - Reserva de Recursos

skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 50
skinparam componentStyle rectangle
skinparam packageStyle rectangle
top to bottom direction

package "FRONTEND · Angular" {
  package "Presentación" as FP #E3F2FD {
    [App (cabecera)] as App
    [SelectorUsuario] as SelectorUsuario
    [RecursosPage] as RecursosPage
    [RecursoCard / RecursoCabecera] as RecursoCard
    [RecursoDetallePage] as RecursoDetallePage
    [ReservasPage] as ReservasPage
    [componentes de reservas\n(Calendario, NavegacionDia, Timeline, ReservasDelDia,\nReservaModal, ReservaCard, AccionDialogo)] as ComponentesReservas
    [common/dialogo] as Dialogo
  }
  package "Datos" as FD #BBDEFB {
    [RecursosService] as RecursosService
    [UsuariosService] as UsuariosService
    [ReservasService] as ReservasService
  }
  package "Modelo del frontend" as FM #FFF8E1 {
    [recurso.model] as RecursoModel
    [usuario.model] as UsuarioModel
    [reserva.model (tipos y reglas)] as ReservaModel
    [common/enums, common/fechas] as ComunFront
  }
}

package "BACKEND · FastAPI" {
  package "Controller" as BC #E8F5E9 {
    [manejador de errores (main)] as Manejador
    [usuarios/controller] as UsuariosController
    [recursos/controller] as RecursosController
    [reservas/controller] as ReservasController
    [usuario actual (X-Usuario-Id)] as UsuarioActual
  }
  package "Service" as BS #C8E6C9 {
    [UsuarioService] as UsuarioService
    [RecursoService] as RecursoService
    [ReservaService] as ReservaService
    [DisponibilidadService] as DisponibilidadService
  }
  package "Repository" as BR #A5D6A7 {
    [UsuarioRepository] as UsuarioRepository
    [RecursoRepository] as RecursoRepository
    [ReservaRepository] as ReservaRepository
  }
  package "Modelo del backend" as BM #FFF8E1 {
    [DTO (usuarios, recursos, reservas)] as DTO
    [Entity (Usuario, Recurso, Reserva)] as Entity
    [common/enums, common/horas] as ComunBack
    [errores del dominio] as Errores
  }
}

database "PostgreSQL · Docker Compose" as BD #ECEFF1 {
  [usuario] as TUsuario
  [recurso] as TRecurso
  [reserva] as TReserva
}

App -down-> RecursosPage : router
App -down-> RecursoDetallePage : router
App -down-> ReservasPage : router
App -right-> SelectorUsuario : input
App -down-> UsuariosService : inject
RecursosPage -right-> RecursoCard : input
RecursosPage -down-> RecursosService : inject
RecursoDetallePage -right-> RecursoCard : input
RecursoDetallePage -right-> ComponentesReservas : input
ReservasPage -right-> ComponentesReservas : input
ComponentesReservas -right-> Dialogo : input
RecursoDetallePage -down-> RecursosService : inject
RecursoDetallePage -down-> ReservasService : inject
ReservasPage -down-> ReservasService : inject
ReservasPage -down-> UsuariosService : inject
ReservasService -right-> UsuariosService : inject

RecursosService -down-> RecursosController : HTTP GET /recursos
UsuariosService -down-> UsuariosController : HTTP GET /usuarios
ReservasService -down-> ReservasController : HTTP /reservas, /disponibilidad (X-Usuario-Id)

UsuariosController -down-> UsuarioService : Depends
RecursosController -down-> RecursoService : Depends
ReservasController -down-> ReservaService : Depends
ReservasController -down-> DisponibilidadService : Depends
ReservasController -right-> UsuarioActual : Depends
UsuarioActual -down-> UsuarioService : Depends
UsuarioService -down-> UsuarioRepository : Depends
RecursoService -down-> RecursoRepository : Depends
ReservaService -down-> ReservaRepository : Depends
DisponibilidadService -down-> ReservaRepository : Depends
ReservaService -right-> DisponibilidadService : llama
ReservaService -left-> RecursoService : llama
ReservaService -left-> UsuarioService : llama
DisponibilidadService -left-> RecursoService : llama
UsuarioRepository -down-> BD : SQL
RecursoRepository -down-> BD : SQL
ReservaRepository -down-> BD : SQL

FP .right.> FM : usa
FD .right.> FM : usa

Manejador .right.> Errores : traduce a HTTP
BC .right.> DTO : usa
BS .right.> DTO : usa
BS .right.> Entity : usa
BS .right.> Errores : lanza
BR .right.> Entity : usa
Entity .down.> BD : mapea

@enduml
