{
  "enableWorkflows": true,
  "enabledPlugins": {
    "core@ai-bank": true,
    "dev@ai-bank": true,
    "meta@ai-bank": true,
    "stack-nestjs@ai-bank": false,
    "stack-react@ai-bank": false
  },
  "extraKnownMarketplaces": {
    "ai-bank": {
      "source": {
        "source": "github",
        "repo": "QudeCode/ai-bank"
      },
      "autoUpdate": true
    }
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./src/backend/.env)",
      "Read(./src/backend/.env.*)"
    ]
  }
}
